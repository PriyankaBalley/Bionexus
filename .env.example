# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=EditEase
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
FLOWER_PORT=5555

# ── Frontend → Backend URL ───────────────────────────────────────────────────
# In Docker network this is http://backend:8000 (default).
# If accessing the backend from outside Docker, use http://localhost:8000.
NEXT_PUBLIC_API_URL=http://backend:8000

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=/data
JOB_TTL_HOURS=72

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── NCBI ─────────────────────────────────────────────────────────────────────
# Required by NCBI Entrez. Use your real email; API key recommended for >3 req/sec.
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# ── Ensembl Plants ───────────────────────────────────────────────────────────
ENSEMBL_PLANTS_URL=https://rest.ensembl.org

# ── Sol Genomics ─────────────────────────────────────────────────────────────
SGN_URL=https://solgenomics.net

# ── Tool binaries (auto-discovered if on $PATH) ──────────────────────────────
CAS_OFFINDER_BIN=cas-offinder
RNAFOLD_BIN=RNAfold
BOWTIE_BIN=bowtie

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_SEQUENCE_LENGTH=200000
MAX_UPSTREAM_BP=10000
MAX_DOWNSTREAM_BP=10000
